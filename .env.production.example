ENVIRONMENT=production
APP_ENV=production
APP_NAME=AI Office
APP_BASE_URL=https://ai-office.example.com
FRONTEND_BASE_URL=https://ai-office.example.com
GENERATED_SITES_ROOT=generated_sites
GENERATED_TOOLS_ROOT=generated_tools
LOG_LEVEL=INFO

AI_OFFICE_REQUIRE_API_KEY=true
AI_OFFICE_API_KEY=change-me-long-random
AI_OFFICE_ADMIN_TOKEN=change-me-long-random-admin-token
AI_OFFICE_ALLOWED_ORIGINS=https://ai-office.example.com
CRON_SECRET=change-me-long-random-cron-secret

DATABASE_URL=postgresql+psycopg2://ai_office:${POSTGRES_PASSWORD}@postgres:5432/ai_office
REDIS_URL=redis://redis:6379/0
WORKER_BACKEND=redis
RQ_QUEUE_NAME=ai_office_tasks

VECTOR_BACKEND=pgvector
RAG_DEFAULT_TOP_K=6
LOCAL_VECTOR_STORE_PATH=data/vector_store/documents.jsonl
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
RAG_LEXICAL_FALLBACK_ENABLED=false
PGVECTOR_SIMILARITY_METRIC=cosine

MODEL_PROVIDER_PRIMARY=openai
MODEL_PROVIDER_FALLBACK=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.5
OPENAI_HEAVY_MODEL=gpt-5.5
DEFAULT_CHEAP_MODEL=gpt-5.4
DEFAULT_MID_MODEL=gpt-5.5
DEFAULT_STRONG_MODEL=gpt-5.5
BRAIN_PROVIDER=openai
BRAIN_BASE_URL=
BRAIN_API_KEY=
BRAIN_CHEAP_MODEL=gpt-5.4
BRAIN_STRONG_MODEL=gpt-5.5
BRAIN_CODE_MODEL=gpt-5.5

TELEGRAM_BOT_TOKEN=
TELEGRAM_PMO_BOT_TOKEN=
TELEGRAM_DATA_ANALYST_BOT_TOKEN=
TELEGRAM_DEVELOPER_BOT_TOKEN=
TELEGRAM_COPYWRITER_BOT_TOKEN=
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_STRATEGIST_BOT_TOKEN=
TELEGRAM_ACCOUNTANT_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
TELEGRAM_ALLOWED_CHAT_IDS=
ALLOWED_TELEGRAM_USER_IDS=
ALLOWED_TELEGRAM_CHAT_IDS=
TELEGRAM_GENERAL_THREAD_ID=
TELEGRAM_PMO_THREAD_ID=
TELEGRAM_DATA_ANALYST_THREAD_ID=
TELEGRAM_DEVELOPER_THREAD_ID=
TELEGRAM_COPYWRITER_THREAD_ID=
TELEGRAM_SUPPORT_THREAD_ID=
TELEGRAM_STRATEGIST_THREAD_ID=
TELEGRAM_ACCOUNTANT_THREAD_ID=

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
SLACK_BOT_TOKEN=
JIRA_URL=
JIRA_USER=
JIRA_API_TOKEN=

ENABLE_REAL_TOOLS=false
ENABLE_APPROVAL_REQUIRED=true
ENABLE_PII_REDACTION=true
ENABLE_COST_TRACKING=true
ENABLE_RAG_CITATIONS=true
AI_OFFICE_DAILY_BUDGET_USD=
AI_OFFICE_MONTHLY_BUDGET_USD=
AI_OFFICE_BUDGET_ENFORCEMENT=warn

ENABLE_PMO_AGENT=true
ENABLE_SUPPORT_AGENT=true
ENABLE_DEVELOPER_AGENT=true
ENABLE_ANALYST_AGENT=true
ENABLE_COPYWRITER_AGENT=true
ENABLE_STRATEGIST_AGENT=true
ENABLE_ACCOUNTANT_AGENT=true

AUTONOMY_ENABLED=false
AUTONOMY_DAILY_PLAN_HOUR=9
AUTONOMY_EVENING_REVIEW_HOUR=19
AUTONOMY_POLL_INTERVAL_SECONDS=1800
AUTONOMY_TIMEZONE=Asia/Almaty
AI_OFFICE_TASK_STUCK_TIMEOUT_MINUTES=30
AI_OFFICE_TASK_MAX_RETRIES=2
AI_OFFICE_APPROVAL_TTL_HOURS=24

AI_OFFICE_WORKSPACE_ROOT=workspaces
AI_OFFICE_ALLOW_FILE_WRITES=false
AI_OFFICE_SAFE_COMMANDS=pytest,python -m pytest,npm test,npm run build
AI_OFFICE_WEB_ACCESS_ENABLED=true
AI_OFFICE_WEB_SEARCH_MAX_RESULTS=5
AI_OFFICE_WEB_FETCH_MAX_CHARS=6000
BRAVE_SEARCH_API_KEY=
