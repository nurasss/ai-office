# ─── LLM API keys ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.5
OPENAI_HEAVY_MODEL=gpt-5.5

# ─── API auth / app ───────────────────────────────────────────────────
AI_OFFICE_REQUIRE_API_KEY=false
AI_OFFICE_API_KEY=replace-with-long-random-value
AI_OFFICE_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
LOG_LEVEL=INFO
ENVIRONMENT=development

# ─── Database ─────────────────────────────────────────────────────────
# Local MVP fallback:
DATABASE_URL=sqlite:///data/ai_office.db
# 24/7 recommended:
# DATABASE_URL=postgresql+psycopg2://ai_office:replace-password@postgres:5432/ai_office

# ─── Vector DB / RAG ──────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=ai-office
PINECONE_ENV=us-east-1

# ─── Telegram ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_PMO_BOT_TOKEN=
TELEGRAM_DATA_ANALYST_BOT_TOKEN=
TELEGRAM_DEVELOPER_BOT_TOKEN=
TELEGRAM_COPYWRITER_BOT_TOKEN=
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_STRATEGIST_BOT_TOKEN=
TELEGRAM_ACCOUNTANT_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-value
ALLOWED_TELEGRAM_USER_IDS=123456789
ALLOWED_TELEGRAM_CHAT_IDS=123456789
TELEGRAM_GENERAL_THREAD_ID=
TELEGRAM_PMO_THREAD_ID=
TELEGRAM_DATA_ANALYST_THREAD_ID=
TELEGRAM_DEVELOPER_THREAD_ID=
TELEGRAM_COPYWRITER_THREAD_ID=
TELEGRAM_SUPPORT_THREAD_ID=
TELEGRAM_STRATEGIST_THREAD_ID=
TELEGRAM_ACCOUNTANT_THREAD_ID=

# ─── Autonomous runtime ───────────────────────────────────────────────
AUTONOMY_ENABLED=false
AUTONOMY_DAILY_PLAN_HOUR=9
AUTONOMY_EVENING_REVIEW_HOUR=19
AUTONOMY_POLL_INTERVAL_SECONDS=1800
AUTONOMY_TIMEZONE=Asia/Almaty
CRON_SECRET=replace-with-long-random-value
AI_OFFICE_TASK_STUCK_TIMEOUT_MINUTES=30
AI_OFFICE_TASK_MAX_RETRIES=2
AI_OFFICE_APPROVAL_TTL_HOURS=24

# ─── Safe developer tools ─────────────────────────────────────────────
AI_OFFICE_WORKSPACE_ROOT=workspaces
AI_OFFICE_ALLOW_FILE_WRITES=false
AI_OFFICE_SAFE_COMMANDS=pytest,python -m pytest,npm test,npm run build
AI_OFFICE_WEB_ACCESS_ENABLED=true
AI_OFFICE_WEB_SEARCH_MAX_RESULTS=5
AI_OFFICE_WEB_FETCH_MAX_CHARS=6000

# ─── External tools ───────────────────────────────────────────────────
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
JIRA_URL=
JIRA_USER=
JIRA_API_TOKEN=
